{
  "name": "agent-harbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "hooks:codex:install": "tsx scripts/configure-codex-hooks.ts install",
    "hooks:codex:preview": "tsx scripts/configure-codex-hooks.ts install --dry-run",
    "hooks:codex:uninstall": "tsx scripts/configure-codex-hooks.ts uninstall",
    "hooks:install": "tsx scripts/configure-claude-hooks.ts install",
    "hooks:preview": "tsx scripts/configure-claude-hooks.ts install --dry-run",
    "hooks:uninstall": "tsx scripts/configure-claude-hooks.ts uninstall",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "tsx --test --test-concurrency=2 scripts/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "watch:claude-desktop": "tsx scripts/watch-claude-desktop.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
